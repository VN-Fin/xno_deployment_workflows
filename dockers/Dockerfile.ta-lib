ARG PYTHON_VERSION
ARG TA_LIB_VERSION

FROM python:${PYTHON_VERSION}-slim AS base

# Install build tools
RUN apt-get update && \
    apt-get install -y --no-install-recommends build-essential wget ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Build TA-Lib
RUN wget -q https://github.com/ta-lib/ta-lib/releases/download/v${TA_LIB_VERSION}/ta-lib-${TA_LIB_VERSION}-src.tar.gz && \
    tar -xzf ta-lib-${TA_LIB_VERSION}-src.tar.gz && \
    cd ta-lib-${TA_LIB_VERSION} && \
    ./configure --prefix=/usr/local && \
    make -j"$(nproc)" && \
    make install && \
    cd .. && \
    rm -rf ta-lib-${TA_LIB_VERSION} ta-lib-${TA_LIB_VERSION}-src.tar.gz

# Verify
RUN python -c "import ctypes; print('TA-Lib library installed')"
